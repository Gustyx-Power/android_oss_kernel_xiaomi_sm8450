#!/bin/bash

SECONDS=0
LOG_FILE="build.log"
BUILD_LOG="$LOG_FILE"
>"$LOG_FILE"

TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_API_SERVER="https://api.telegram.org"

BUILD_SUCCESS=false
BUILD_ERROR_MSG=""
TELEGRAM_MESSAGE_ID=""

ANYKERNEL_REPO="https://github.com/pavelc4-playground/AnyKernel3.git"
ANYKERNEL_DIR="../AnyKernel3"
KERNEL_VERSION="5.10.xx"
KERNEL_NAME="XtraAether"

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

if git rev-parse --show-toplevel > /dev/null 2>&1; then
    KP_ROOT="$(git rev-parse --show-toplevel)"
else
    KP_ROOT="$SCRIPT_DIR"
fi

find_aosp_root() {
    local dir="$KP_ROOT"
    while [[ "$dir" != "/" ]]; do
        if [[ -d "$dir/.repo" ]]; then
            echo "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done
    return 1
}

if [ -f ".build.rc" ]; then
    source .build.rc
    echo "Loaded from .build.rc: SRC_ROOT=$SRC_ROOT"
else
    if SRC_ROOT="$(find_aosp_root)"; then
        echo "AOSP Source Root: $SRC_ROOT"
    else
        SRC_ROOT="$(realpath "$KP_ROOT/../..")"
        echo "Using fallback SRC_ROOT: $SRC_ROOT"
    fi
fi

TC_DIR="$HOME/path/to/your/clang"
PREBUILTS_DIR="$SRC_ROOT/prebuilts/kernel-build-tools/linux-x86"
BRANCH="$(git branch --show-current)"
MODULES_REPO="sm8450-modules"
DT_REPO="sm8450-devicetrees"

CLANG_NAME="$(basename "$TC_DIR")"
FLASHABLE_DIR="$KP_ROOT/flashable"
mkdir -p "$FLASHABLE_DIR"

DO_CLEAN=false
ONLY_CONFIG=false
ONLY_KERNEL=false
ONLY_DTB=false
ONLY_MODULES=false
MAKE_ZIP=false
UPLOAD_TG=false
UPLOAD_ONLY=false
TARGET=
DTB_WILDCARD="*"
DTBO_WILDCARD="*"

echo_i() { 
    echo -e "\n\033[1;36m==> $1\033[0m\n" | tee -a "$LOG_FILE"
}
echo_w() { 
    echo -e "\033[1;33m⚠ $1\033[0m" | tee -a "$LOG_FILE"
}
echo_e() { 
    echo -e "\n\033[1;31m✗ $1\033[0m\n" | tee -a "$LOG_FILE"
}
echo_s() { 
    echo -e "\033[1;32m✓ $1\033[0m" | tee -a "$LOG_FILE"
}

auto_apply_patches() {
    echo_i "Checking for patches..."
    
    local patches_found=0
    local patches_applied=0
    
    # Look for .patch files in current directory
    for patch_file in *.patch; do
        [ -f "$patch_file" ] || continue
        patches_found=$((patches_found + 1))
        
        echo "Found patch: $patch_file"
        
        # Check if patch is already applied
        if patch -p1 --dry-run --reverse < "$patch_file" > /dev/null 2>&1; then
            echo_w "Patch already applied: $patch_file (skipping)"
            continue
        fi
        
        # Check if patch can be applied
        if patch -p1 --dry-run < "$patch_file" > /dev/null 2>&1; then
            echo "Applying patch: $patch_file"
            if patch -p1 < "$patch_file" >> "$LOG_FILE" 2>&1; then
                echo_s "Successfully applied: $patch_file"
                patches_applied=$((patches_applied + 1))
            else
                echo_e "Failed to apply: $patch_file"
                return 1
            fi
        else
            echo_w "Patch cannot be applied (conflicts or already applied): $patch_file"
        fi
    done
    
    if [ $patches_found -eq 0 ]; then
        echo "No patches found"
    else
        echo_s "Patches: $patches_applied applied, $((patches_found - patches_applied)) skipped"
    fi
    
    return 0
}

tg_send_msg() {
    $UPLOAD_TG || return 0
    [ -z "$TELEGRAM_BOT_TOKEN" ] || [ -z "$TELEGRAM_CHAT_ID" ] && return 0

    local stage="$1"
    local elapsed_h=$((SECONDS / 3600))
    local elapsed_m=$(((SECONDS % 3600) / 60))
    local elapsed_s=$((SECONDS % 60))
    local elapsed="$(printf '%dh:%02dm:%02ds' $elapsed_h $elapsed_m $elapsed_s)"
    local now="$(date '+%Y-%m-%d %H:%M:%S')"

    local msg="<b>Build Progress</b>
<b>Kernel:</b> ${KERNEL_NAME}
<b>Device:</b> ${TARGET}
<b>Clang:</b> ${CLANG_NAME}
<b>Stage:</b> ${stage}
<b>Elapsed:</b> ${elapsed}
<b>Timestamp:</b> ${now}"

    local response
    if [ -z "$TELEGRAM_MESSAGE_ID" ]; then
        # Send new message and save message_id
        response=$(curl -s -X POST \
            "${TELEGRAM_API_SERVER}/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
            -d "chat_id=${TELEGRAM_CHAT_ID}" \
            -d "text=${msg}" \
            -d "parse_mode=HTML")
        
        TELEGRAM_MESSAGE_ID=$(echo "$response" | grep -o '"message_id":[0-9]*' | head -1 | cut -d: -f2)
    else
        # Edit existing message
        curl -s -X POST \
            "${TELEGRAM_API_SERVER}/bot${TELEGRAM_BOT_TOKEN}/editMessageText" \
            -d "chat_id=${TELEGRAM_CHAT_ID}" \
            -d "message_id=${TELEGRAM_MESSAGE_ID}" \
            -d "text=${msg}" \
            -d "parse_mode=HTML" > /dev/null 2>&1
    fi
}

tg_send_error() {
    [ -z "$TELEGRAM_BOT_TOKEN" ] || [ -z "$TELEGRAM_CHAT_ID" ] && return 0

    local error_stage="$1"
    local error_detail="$2"
    local elapsed_h=$((SECONDS / 3600))
    local elapsed_m=$(((SECONDS % 3600) / 60))
    local elapsed_s=$((SECONDS % 60))
    local elapsed="$(printf '%dh:%02dm:%02ds' $elapsed_h $elapsed_m $elapsed_s)"
    local now="$(date '+%Y-%m-%d %H:%M:%S')"

    local msg="<b>❌ BUILD FAILED!</b>

<b>Kernel:</b> ${KERNEL_NAME}
<b>Device:</b> ${TARGET}
<b>Clang:</b> ${CLANG_NAME}
<b>Failed at:</b> ${error_stage}
<b>Elapsed:</b> ${elapsed}
<b>Timestamp:</b> ${now}

<b>Error Details:</b>
<code>${error_detail}</code>

Build log will be uploaded next..."

    curl -s -X POST \
        "${TELEGRAM_API_SERVER}/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
        -d "chat_id=${TELEGRAM_CHAT_ID}" \
        -d "text=${msg}" \
        -d "parse_mode=HTML" > /dev/null 2>&1
    
    # Auto upload build log after error message
    tg_send_log "Failed"
}

tg_send_log() {
    [ -z "$TELEGRAM_BOT_TOKEN" ] || [ -z "$TELEGRAM_CHAT_ID" ] && {
        echo_w "Telegram credentials not configured"
        return 0
    }
    
    [ ! -f "$BUILD_LOG" ] && {
        echo_w "Build log file not found: $BUILD_LOG"
        return 0
    }

    echo_i "Uploading build.log to Telegram..."
    
    # Get absolute path
    local log_path="$(realpath "$BUILD_LOG")"
    local log_size=$(stat -c%s "$log_path" 2>/dev/null || echo "0")
    
    echo "Log file: $log_path"
    echo "Log size: $log_size bytes ($(du -h "$log_path" | awk '{print $1}'))"
    
    # Check if file is readable
    if [ ! -r "$log_path" ]; then
        echo_e "Build log is not readable!"
        return 1
    fi
    
    # Check if file is too large (Telegram limit is 50MB)
    if [ "$log_size" -gt 52428800 ]; then
        echo_w "Build log is too large (>50MB), truncating..."
        local temp_log="/tmp/build_log_truncated.txt"
        head -n 5000 "$log_path" > "$temp_log"
        echo -e "\n\n... [LOG TRUNCATED - TOO LARGE] ...\n\n" >> "$temp_log"
        tail -n 5000 "$log_path" >> "$temp_log"
        log_path="$temp_log"
        log_size=$(stat -c%s "$log_path")
    fi

    local status_text="$1"
    [ -z "$status_text" ] && status_text="Failed"

    local caption="Build Log - ${KERNEL_NAME} - ${TARGET} - ${status_text}"

    local max_retries=3
    local retry=0
    local response

    while [ $retry -lt $max_retries ]; do
        echo "Upload attempt $((retry + 1))/$max_retries..."
        
        response=$(curl -X POST \
            "${TELEGRAM_API_SERVER}/bot${TELEGRAM_BOT_TOKEN}/sendDocument" \
            -F chat_id="${TELEGRAM_CHAT_ID}" \
            -F document="@${log_path}" \
            -F caption="${caption}" \
            --connect-timeout 30 \
            --max-time 120 2>&1)

        if echo "$response" | grep -q '"ok":true'; then
            echo_s "Build log uploaded to Telegram"
            [ -f "/tmp/build_log_truncated.txt" ] && rm -f "/tmp/build_log_truncated.txt"
            return 0
        else
            echo_w "Upload attempt $((retry + 1)) failed"
            if [ $retry -eq $((max_retries - 1)) ]; then
                echo_e "Failed to upload build log after $max_retries attempts"
                echo "Response:" | tee -a "$BUILD_LOG"
                echo "$response" | grep -v "^*" | tee -a "$BUILD_LOG"
            fi
            retry=$((retry + 1))
            [ $retry -lt $max_retries ] && sleep 3
        fi
    done
    
    [ -f "/tmp/build_log_truncated.txt" ] && rm -f "/tmp/build_log_truncated.txt"
    return 1
}

while [ $# -gt 0 ]; do
    case "$1" in
        -c | --clean) DO_CLEAN=true ;;
        -o | --only-config) ONLY_CONFIG=true ;;
        -k | --only-kernel) ONLY_KERNEL=true ;;
        -d | --only-dtb) ONLY_DTB=true ;;
        -m | --only-modules) ONLY_MODULES=true ;;
        -z | --zip) MAKE_ZIP=true ;;
        -t | --telegram) UPLOAD_TG=true ;;
        -u | --upload-only) UPLOAD_ONLY=true; UPLOAD_TG=true ;;
        --src-root) SRC_ROOT="$2"; shift ;;
        --tg-token) TELEGRAM_BOT_TOKEN="$2"; shift ;;
        --tg-chat) TELEGRAM_CHAT_ID="$2"; shift ;;
        -h | --help)
            echo "Usage: $0 [options] <target>"
            echo "Options:"
            echo "  -c, --clean         Clean build"
            echo "  -o, --only-config   Generate config only"
            echo "  -k, --only-kernel   Build kernel only"
            echo "  -d, --only-dtb      Build DTB only"
            echo "  -m, --only-modules  Build modules only"
            echo "  -z, --zip           Create AnyKernel3 zip"
            echo "  -t, --telegram      Upload to Telegram"
            echo "  -u, --upload-only   Upload existing zip to Telegram (skip build)"
            echo "  --src-root PATH     Override SRC_ROOT"
            echo "  --tg-token TOKEN    Telegram bot token"
            echo "  --tg-chat ID        Telegram chat ID"
            exit 0
            ;;
        *) TARGET="$1" ;;
    esac
    shift
done

if [ -z "$TARGET" ]; then
    echo "Target (device) not specified!"
    echo "Example: $0 marble"
    echo "Example with zip: $0 -z marble"
    echo "Example with Telegram: $0 -z -t marble"
    echo "Example upload only: $0 -u marble"
    exit 1
fi

KERNEL_DIR="$SRC_ROOT/device/xiaomi/$TARGET-kernel"

if [ ! -d "$KERNEL_DIR" ]; then
    echo_i "Setting up kernel output directory structure..."
    mkdir -p "$KERNEL_DIR" || {
        echo_e "Failed to create $KERNEL_DIR"
        exit 1
    }
    mkdir -p "$KERNEL_DIR/dtbs"
    mkdir -p "$KERNEL_DIR/vendor_ramdisk"
    mkdir -p "$KERNEL_DIR/vendor_dlkm"
    echo_s "Created kernel directory structure"
else
    mkdir -p "$KERNEL_DIR/dtbs"
    mkdir -p "$KERNEL_DIR/vendor_ramdisk"
    mkdir -p "$KERNEL_DIR/vendor_dlkm"
fi

KERNEL_COPY_TO="$KERNEL_DIR"
DTB_COPY_TO="$KERNEL_DIR/dtbs"
DTBO_COPY_TO="$DTB_COPY_TO/dtbo.img"
VBOOT_DIR="$KERNEL_DIR/vendor_ramdisk"
VDLKM_DIR="$KERNEL_DIR/vendor_dlkm"

DEFCONFIG="gki_defconfig"
DEFCONFIGS="vendor/waipio_GKI.config \
vendor/xiaomi_GKI.config \
vendor/debugfs.config \
vendor/addon.config"

MODULES_SRC="../$MODULES_REPO/qcom/opensource"
MODULES="mmrm-driver \
audio-kernel \
camera-kernel \
cvp-kernel \
dataipa/drivers/platform/msm \
datarmnet/core \
datarmnet-ext/aps \
datarmnet-ext/offload \
datarmnet-ext/shs \
datarmnet-ext/perf \
datarmnet-ext/perf_tether \
datarmnet-ext/sch \
datarmnet-ext/wlan \
display-drivers/msm \
eva-kernel \
video-driver \
wlan/qcacld-3.0/.qca6490"

case "$TARGET" in
    "marble" )
        DTB_WILDCARD="ukee"
        DTBO_WILDCARD="marble-sm7475-pm8008-overlay"
        ;;
    "cupid" )
        DTB_WILDCARD="waipio"
        DTBO_WILDCARD="cupid-sm8450-pm8008-overlay"
        ;;
esac

export PATH="$TC_DIR/bin:$PREBUILTS_DIR/bin:$PATH"
export CC="$TC_DIR/bin/clang"
export CXX="$TC_DIR/bin/clang++"
export HOSTCC="$TC_DIR/bin/clang"
export HOSTCXX="$TC_DIR/bin/clang++"
export LD="$TC_DIR/bin/ld.lld"
export AR="$TC_DIR/bin/llvm-ar"
export NM="$TC_DIR/bin/llvm-nm"
export OBJCOPY="$TC_DIR/bin/llvm-objcopy"
export OBJDUMP="$TC_DIR/bin/llvm-objdump"
export STRIP="$TC_DIR/bin/llvm-strip"

echo "Using clang: $CC"
$CC --version

DTC_PATH="$PREBUILTS_DIR/bin/dtc"
UFDT_PATH="$PREBUILTS_DIR/bin/ufdt_apply_overlay"

if ! command -v python3 &> /dev/null; then
    echo_e "python3 not found! Install with: sudo apt install python3"
    exit 1
fi

if [ ! -f "$DTC_PATH" ]; then
    echo_w "Prebuilt DTC not found at $DTC_PATH"
    if command -v dtc &> /dev/null; then
        DTC_PATH="$(command -v dtc)"
        echo_s "Using system DTC: $DTC_PATH"
        dtc --version
    else
        echo_e "DTC not found! Install with: sudo apt install device-tree-compiler"
        exit 1
    fi
fi

if [ ! -f "$UFDT_PATH" ]; then
    echo_w "ufdt_apply_overlay not found, DTB overlay testing will be skipped"
    UFDT_PATH=""
fi

m() {
    local make_args=(
        -j$(nproc --all)
        O=out
        ARCH=arm64
        LLVM=1
        LLVM_IAS=1
        LLVM_PREFIX="$TC_DIR/bin/"
        CC="$CC"
        CXX="$CXX"
        HOSTCC="$HOSTCC"
        HOSTCXX="$HOSTCXX"
        LD="$LD"
        AR="$AR"
        NM="$NM"
        OBJCOPY="$OBJCOPY"
        OBJDUMP="$OBJDUMP"
        STRIP="$STRIP"
        DTC_EXT="$DTC_PATH"
        TARGET_PRODUCT=$TARGET
    )

    if [ -n "$UFDT_PATH" ]; then
        make_args+=(DTC_OVERLAY_TEST_EXT="$UFDT_PATH")
    fi

    make "${make_args[@]}" "$@" 2>&1 | tee -a "$LOG_FILE"
    local ret=${PIPESTATUS[0]}
    if [ $ret -ne 0 ]; then
        BUILD_ERROR_MSG="Make command failed with exit code $ret"
        return $ret
    fi
    return 0
}

build_all() {
    echo_i "Building kernel, modules, and dtbs..."
    tg_send_msg "Building kernel, modules, and dtbs..."
    
    if ! m Image modules dtbs; then
        BUILD_ERROR_MSG="Failed to build kernel, modules, or dtbs"
        tg_send_error "Kernel/Modules/DTBs Build" "$BUILD_ERROR_MSG"
        exit 1
    fi
    
    echo_s "Kernel compiled successfully!"
    tg_send_msg "Kernel compiled"

    rm -rf out/modules
    
    if ! m INSTALL_MOD_PATH=modules INSTALL_MOD_STRIP=1 modules_install; then
        BUILD_ERROR_MSG="Failed to install modules"
        tg_send_error "Modules Install" "$BUILD_ERROR_MSG"
        exit 1
    fi
}

build_techpack_modules() {
    echo_i "Building techpack modules..."
	if [ ! -d "$MODULES_SRC" ]; then
      echo_w "Module sources not found at $MODULES_SRC"
      echo_w "Skipping techpack modules..."
      return 0
    fi

    for module in $MODULES; do
	if [ ! -d "$MODULES_SRC/$module" ]; then
        echo_w "Module $module not found, skipping..."
        continue
    fi
        echo "Building $module..." | tee -a "$LOG_FILE"
        
        if ! m -C $MODULES_SRC/$module M=$MODULES_SRC/$module KERNEL_SRC="$(pwd)" OUT_DIR="$(pwd)/out"; then
            BUILD_ERROR_MSG="Failed to build techpack module: $module"
            tg_send_error "Techpack Module Build" "$BUILD_ERROR_MSG"
            exit 1
        fi
        
        if ! m -C $MODULES_SRC/$module M=$MODULES_SRC/$module KERNEL_SRC="$(pwd)" OUT_DIR="$(pwd)/out" \
            INSTALL_MOD_PATH=modules INSTALL_MOD_STRIP=1 modules_install; then
            BUILD_ERROR_MSG="Failed to install techpack module: $module"
            tg_send_error "Techpack Module Install" "$BUILD_ERROR_MSG"
            exit 1
        fi
    done
    echo_s "Techpack modules build completed"
    tg_send_msg "Techpack modules done"
}

copy_kernel() {
    echo_i "Copying kernel..."
    cp out/arch/arm64/boot/Image $KERNEL_COPY_TO
    echo_s "Copied kernel to $KERNEL_COPY_TO"
}

copy_to_flashable() {
    echo_i "Copying kernel image to flashable/..."
    local img_gz="out/arch/arm64/boot/Image.gz"
    local img_raw="out/arch/arm64/boot/Image"
    if [ -f "$img_gz" ]; then
        cp "$img_gz" "$FLASHABLE_DIR/"
        echo_s "Image.gz copied to $FLASHABLE_DIR/"
    elif [ -f "$img_raw" ]; then
        echo_w "Image.gz not found, using Image instead"
        cp "$img_raw" "$FLASHABLE_DIR/"
        echo_s "Image copied to $FLASHABLE_DIR/"
    else
        echo_e "No kernel image found!"
        return 1
    fi
    tg_send_msg "Kernel image copied to flashable/"
}

process_dtbs() {
    echo_i "Merging dtbs..."
    rm -rf out/dtbs{,-base}
    mkdir -p out/dtbs out/dtbs-base

    mv out/arch/arm64/boot/dts/vendor/qcom/$DTB_WILDCARD.dtb \
       out/arch/arm64/boot/dts/vendor/qcom/$DTBO_WILDCARD.dtbo \
       out/dtbs-base 2>/dev/null || {
        echo_w "Some DTB files not found, continuing..."
    }

    rm -f out/arch/arm64/boot/dts/vendor/qcom/*.dtbo

    if [ -f "$SRC_ROOT/build/android/merge_dtbs.py" ]; then
        python3 "$SRC_ROOT/build/android/merge_dtbs.py" out/dtbs-base out/arch/arm64/boot/dts/vendor/qcom/ out/dtbs 2> >(tee -a "$LOG_FILE") || exit $?
    else
		echo_w "merge_dtbs.py not found at $SRC_ROOT/build/android/merge_dtbs.py"
        echo_w "Copying DTBs directly..."
        cp out/arch/arm64/boot/dts/vendor/qcom/*.dtb out/dtbs/ 2>/dev/null || true
    fi

    if [ -d "$DTB_COPY_TO" ]; then
        rm -f $DTB_COPY_TO/*.dtb
        cp out/dtbs/*.dtb $DTB_COPY_TO 2>/dev/null || echo_w "No DTB files to copy"
    else
        rm -f $DTB_COPY_TO
        cat out/dtbs/*.dtb >> $DTB_COPY_TO 2>/dev/null || echo_w "No DTB files"
    fi
    echo_s "Copied dtb(s) to $DTB_COPY_TO"

    if command -v mkdtboimg.py &> /dev/null; then
        if ls out/dtbs/*.dtbo 1> /dev/null 2>&1; then
            mkdtboimg.py create $DTBO_COPY_TO --page_size=4096 out/dtbs/*.dtbo 2> >(tee -a "$LOG_FILE") || {
                echo_w "Failed to create DTBO image"
            }
            echo_s "Generated dtbo.img to $DTBO_COPY_TO"
        else
            echo_w "No DTBO files found"
        fi
    else
        echo_w "mkdtboimg.py not found, skipping DTBO"
    fi
}

install_modules() {
    echo_i "Installing modules..."

    first_stage_modules="$(cat modules.list.msm.waipio 2>/dev/null || echo '')"
    second_stage_modules="$(cat modules.list.second_stage modules.list.second_stage.$TARGET 2>/dev/null || echo '')"
    vendor_dlkm_modules="$(cat modules.list.vendor_dlkm modules.list.vendor_dlkm.$TARGET 2>/dev/null || echo '')"
    modules_out="out/modules/lib/modules/$(ls -t out/modules/lib/modules/ | head -n1)"

    rm -rf "$VBOOT_DIR" "$VDLKM_DIR"
    mkdir -p "$VBOOT_DIR" "$VDLKM_DIR"

    for module in $first_stage_modules; do
        mod_path=$(find $modules_out -name "$module" -print -quit)
        [ -z "$mod_path" ] && continue
        cp $mod_path $VBOOT_DIR
        echo $module >> $VBOOT_DIR/modules.load
        echo $module >> $VBOOT_DIR/modules.load.recovery
    done

    for module in $second_stage_modules; do
        mod_path=$(find $modules_out -name "$module" -print -quit)
        [ -z "$mod_path" ] && continue
        cp $mod_path $VBOOT_DIR
        cp $mod_path $VDLKM_DIR
        echo $module >> $VBOOT_DIR/modules.load.recovery
        echo $module >> $VDLKM_DIR/modules.load
    done

    for module in $vendor_dlkm_modules; do
        mod_path=$(find $modules_out -name "$module" -print -quit)
        [ -z "$mod_path" ] && continue
        cp $mod_path $VDLKM_DIR
        echo $module >> $VDLKM_DIR/modules.load
    done

    for dest_dir in $VBOOT_DIR $VDLKM_DIR; do
        [ -f "modules.vendor_blocklist.msm.waipio" ] && cp modules.vendor_blocklist.msm.waipio $dest_dir/modules.blocklist
        cp $modules_out/modules.{alias,dep,softdep} $dest_dir 2>/dev/null || true
    done

    [ -f "$VBOOT_DIR/modules.dep" ] && sed -E -i 's#([^: ]*/)([^/]*\.ko)([:]?)([ ]|$)#/lib/modules/\2\3\4#g' "$VBOOT_DIR/modules.dep"
    [ -f "$VDLKM_DIR/modules.dep" ] && sed -E -i 's#([^: ]*/)([^/]*\.ko)([:]?)([ ]|$)#/vendor_dlkm/lib/modules/\2\3\4#g' "$VDLKM_DIR/modules.dep"

    echo_s "Modules installation completed"
    tg_send_msg "Modules installed"
    
    # Copy special modules to flashable
    copy_modules_to_flashable
}

copy_modules_to_flashable() {
    echo_i "Copying special modules to flashable/modules/..."
    
    mkdir -p "$FLASHABLE_DIR/modules"
    rm -f "$FLASHABLE_DIR/modules"/*.ko
    
    local modules_out="out/modules/lib/modules/$(ls -t out/modules/lib/modules/ | head -n1)"
    local copied_count=0
    
    # List of special modules to copy (add more as needed)
    local special_modules="qti_battery_charger_main.ko"
    
    for module_name in $special_modules; do
        local mod_path=$(find "$modules_out" -name "$module_name" -print -quit 2>/dev/null)
        
        if [ -n "$mod_path" ] && [ -f "$mod_path" ]; then
            cp "$mod_path" "$FLASHABLE_DIR/modules/"
            echo_s "  Copied: $module_name"
            copied_count=$((copied_count + 1))
        else
            echo_w "  Not found: $module_name"
        fi
    done
    
    if [ $copied_count -gt 0 ]; then
        echo_s "Copied $copied_count module(s) to flashable/modules/"
    else
        echo_w "No special modules copied to flashable/modules/"
    fi
}

setup_anykernel() {
    echo_i "Setting up AnyKernel3..."

    if [ ! -d "$ANYKERNEL_DIR" ]; then
        echo "Cloning AnyKernel3 repository..."
        git clone --depth=1 "$ANYKERNEL_REPO" "$ANYKERNEL_DIR" || {
            echo_e "Failed to clone AnyKernel3"
            return 1
        }
    else
        echo "AnyKernel3 already exists, pulling updates..."
        git -C "$ANYKERNEL_DIR" pull || echo_w "Failed to update, using existing"
    fi

    rm -rf "$ANYKERNEL_DIR"/*.zip
    rm -rf "$ANYKERNEL_DIR"/Image*
    rm -rf "$ANYKERNEL_DIR"/dtb*
    rm -rf "$ANYKERNEL_DIR"/modules

    echo_s "AnyKernel3 ready"
}

create_zip() {
    echo_i "Creating flashable zip from flashable/..."
    tg_send_msg "Zipping flashable..."

    # Get kernel version from multiple sources
    local kernel_ver=""
    
    # Try from include/generated/utsrelease.h
    if [ -f "out/include/generated/utsrelease.h" ]; then
        kernel_ver=$(grep 'UTS_RELEASE' out/include/generated/utsrelease.h | cut -d'"' -f2)
    fi
    
    # Fallback: try from compiled kernel binary
    if [ -z "$kernel_ver" ] && [ -f "out/arch/arm64/boot/Image" ]; then
        kernel_ver=$(strings out/arch/arm64/boot/Image 2>/dev/null | grep -m1 "Linux version" | awk '{print $3}')
    fi
    
    # Fallback: try from .config
    if [ -z "$kernel_ver" ]; then
        kernel_ver=$(grep "Linux/arm64" out/.config 2>/dev/null | head -1 | awk '{print $3}')
    fi
    
    # Final fallback
    if [ -z "$kernel_ver" ]; then
        kernel_ver="5.10.xx"
    fi
    
    echo "Detected kernel version: $kernel_ver"
    
    local date_str="$(date +%Y%m%d-%H%M%S)"
    ZIP_NAME="${KERNEL_NAME}-${kernel_ver}-${TARGET}-${date_str}.zip"
    ZIP_PATH="$KP_ROOT/$ZIP_NAME"

    cd "$FLASHABLE_DIR" || return 1
    echo "Zipping $ZIP_NAME..."
    zip -r9 "$ZIP_PATH" * -x .git README.md .gitignore *.zip 2>&1 | tee -a "$KP_ROOT/$LOG_FILE"
    cd - > /dev/null

    if [ -f "$ZIP_PATH" ]; then
        echo_s "Flashable zip created: $ZIP_PATH"
        return 0
    else
        echo_e "Failed to create zip"
        return 1
    fi
}

send_to_telegram() {
    local file="$1"

    if [ -z "$TELEGRAM_BOT_TOKEN" ] || [ -z "$TELEGRAM_CHAT_ID" ]; then
        echo_e "Telegram bot token or chat ID not configured!"
        return 1
    fi

    if [ ! -f "$file" ]; then
        echo_e "File not found: $file"
        return 1
    fi

    echo_i "Uploading to Telegram: $(basename "$file")..."
    
    # Get absolute path
    local file_path="$(realpath "$file")"
    local file_size=$(stat -c%s "$file_path" 2>/dev/null || echo "0")
    
    echo "File: $file_path"
    echo "Size: $file_size bytes ($(du -h "$file_path" | awk '{print $1}'))"
    
    # Check if file is readable
    if [ ! -r "$file_path" ]; then
        echo_e "File is not readable!"
        return 1
    fi
    
    # Check Telegram file size limit (50MB)
    if [ "$file_size" -gt 52428800 ]; then
        echo_e "File is too large for Telegram (>50MB): $(du -h "$file_path" | awk '{print $1}')"
        return 1
    fi

    local md5=$(md5sum "$file_path" | awk '{print $1}')
    local filename=$(basename "$file_path")
    local filesize=$(du -h "$file_path" | awk '{print $1}')
    local hours=$((SECONDS / 3600))
    local minutes=$(((SECONDS % 3600) / 60))
    local secs=$((SECONDS % 60))
    local build_time=$(printf "%dh:%02dm:%02ds" $hours $minutes $secs)
    local kernel_ver=$(grep "Linux/arm64" out/.config 2>/dev/null | head -1 | awk '{print $3}' || echo "Unknown")
    local compiler="$CLANG_NAME"
    
    # Simplified caption without HTML
    local caption="KERNEL BUILD SUCCESS!
${KERNEL_NAME} - ${TARGET}
Version: ${kernel_ver}
Compiler: ${compiler}
Build Time: ${build_time}
Size: ${filesize}
MD5: ${md5}"

    local max_retries=3
    local retry=0
    local response

    while [ $retry -lt $max_retries ]; do
        echo "Upload attempt $((retry + 1))/$max_retries..."
        
        response=$(curl -X POST \
            "${TELEGRAM_API_SERVER}/bot${TELEGRAM_BOT_TOKEN}/sendDocument" \
            -F chat_id="${TELEGRAM_CHAT_ID}" \
            -F document="@${file_path}" \
            -F caption="${caption}" \
            --connect-timeout 60 \
            --max-time 600 2>&1)

        if echo "$response" | grep -q '"ok":true'; then
            echo_s "Successfully uploaded to Telegram!"

            local message_id=$(echo "$response" | grep -o '"message_id":[0-9]*' | head -1 | cut -d: -f2)
            if [ -n "$message_id" ]; then
                echo "Pinning message..."
                curl -s -X POST \
                    "${TELEGRAM_API_SERVER}/bot${TELEGRAM_BOT_TOKEN}/pinChatMessage" \
                    -d "chat_id=${TELEGRAM_CHAT_ID}" \
                    -d "message_id=${message_id}" \
                    -d "disable_notification=false" > /dev/null 2>&1
                echo_s "Message pinned!"
            fi
            return 0
        else
            echo_w "Upload attempt $((retry + 1)) failed"
            if [ $retry -eq $((max_retries - 1)) ]; then
                echo_e "Failed to upload to Telegram after $max_retries attempts"
                echo "Response:" | tee -a "$BUILD_LOG"
                echo "$response" | grep -v "^*" | grep -v "^%" | tee -a "$BUILD_LOG"
            fi
            retry=$((retry + 1))
            [ $retry -lt $max_retries ] && sleep 5
        fi
    done

    echo "File: $file_path ($file_size bytes)" | tee -a "$BUILD_LOG"
    return 1
}

$DO_CLEAN && {
    rm -rf out $MODULES_REPO
    echo_s "Cleaned output directories"
}

# Auto-apply patches before build
auto_apply_patches || {
    echo_e "Failed to apply patches"
    exit 1
}

# Upload only mode - find and upload latest zip
if $UPLOAD_ONLY; then
    echo_i "Upload-only mode: searching for latest zip..."
    
    # Find latest zip file matching pattern
    LATEST_ZIP=$(ls -t ${KERNEL_NAME}-*-${TARGET}-*.zip 2>/dev/null | head -1)
    
    if [ -z "$LATEST_ZIP" ]; then
        echo_e "No zip file found matching pattern: ${KERNEL_NAME}-*-${TARGET}-*.zip"
        echo "Available zip files:"
        ls -lh *.zip 2>/dev/null || echo "  (none)"
        exit 1
    fi
    
    echo_s "Found: $LATEST_ZIP"
    
    if send_to_telegram "$LATEST_ZIP"; then
        echo_s "Upload completed successfully!"
        exit 0
    else
        echo_e "Upload failed!"
        exit 1
    fi
fi

mkdir -p out

echo_i "Generating config..."
m $DEFCONFIG
m ./scripts/kconfig/merge_config.sh $DEFCONFIGS vendor/${TARGET}_GKI.config
scripts/config --file out/.config -d LOCALVERSION_AUTO

$ONLY_CONFIG && exit

# Detect optimization flags from config
OPT_FLAGS=""
if grep -q 'CONFIG_LTO_CLANG_FULL=y' out/.config 2>/dev/null; then
    OPT_FLAGS="${OPT_FLAGS}+LTO_FULL"
elif grep -q 'CONFIG_LTO_CLANG_THIN=y' out/.config 2>/dev/null; then
    OPT_FLAGS="${OPT_FLAGS}+LTO_THIN"
fi
if grep -q 'CONFIG_PGO_CLANG=y' out/.config 2>/dev/null; then
    OPT_FLAGS="${OPT_FLAGS}+PGO"
fi
if grep -q 'CONFIG_POLLY_CLANG=y' out/.config 2>/dev/null; then
    OPT_FLAGS="${OPT_FLAGS}+POLLY"
fi

export KBUILD_COMPILER_STRING="${CLANG_NAME}${OPT_FLAGS}"
echo_i "Compiler string: $KBUILD_COMPILER_STRING"

tg_send_msg "Build Started"

if $ONLY_KERNEL; then
    m Image
    copy_kernel
    copy_to_flashable
    BUILD_SUCCESS=true
elif $ONLY_DTB; then
    m dtbs
    process_dtbs
    BUILD_SUCCESS=true
elif $ONLY_MODULES; then
    m modules
    build_techpack_modules
    install_modules
    BUILD_SUCCESS=true
else
    build_all
    build_techpack_modules
    copy_kernel
    copy_to_flashable
    process_dtbs
    install_modules
    BUILD_SUCCESS=true
fi

if $MAKE_ZIP; then
    create_zip || {
        echo_e "Failed to create zip"
        BUILD_SUCCESS=false
    }

    if [ "$BUILD_SUCCESS" = true ] && $UPLOAD_TG && [ -f "$ZIP_PATH" ]; then
        if ! send_to_telegram "$ZIP_PATH"; then
            echo_e "Failed to upload kernel zip to Telegram"
        fi
    fi
fi

if [ "$BUILD_SUCCESS" = true ]; then
    tg_send_msg "Build Complete — $((SECONDS / 60))m $((SECONDS % 60))s"
    
    # Send build log on success if telegram upload enabled
    if $UPLOAD_TG; then
        tg_send_log "Success"
    fi
    
    echo_i "Completed in $((SECONDS / 60))m $((SECONDS % 60))s!"
    echo_s "Build log saved to: $BUILD_LOG"
else
    echo_e "Build completed with errors"
    exit 1
fi
